# Porta do BFF
PORT=3333

# Banco: Azure SQL Database (SQL Server).
#
# Monte a string com os dados do portal do Azure (SQL database > Connection
# strings > ADO.NET traz servidor e banco; o usuario e a senha sao os do login
# administrador do servidor SQL).
#
#   DATABASE_URL="sqlserver://SERVIDOR.database.windows.net:1433;database=BANCO;user=USUARIO;password=SENHA;encrypt=true;trustServerCertificate=false"
#
# Detalhes que costumam custar tempo:
#  - `encrypt=true` e obrigatorio no Azure SQL.
#  - Senha com ; { } ou = precisa vir entre chaves:  password={mi;nha=senha}
#  - O usuario pode exigir o sufixo do servidor:     user=admin@servidor
#  - Libere o IP da sua maquina em: SQL server > Networking > Firewall rules.
#    Sem isso o erro e um timeout, nao uma mensagem de permissao.
#
# SQL SERVER LOCAL (on-premises):
#
#   DATABASE_URL="sqlserver://SERVIDOR:1433;database=trigo_portal_db;user=USUARIO;password=SENHA;encrypt=true;trustServerCertificate=true"
#
# Diferencas em relacao ao Azure:
#  - `trustServerCertificate=true` porque o certificado costuma ser autoassinado.
#    Em servidor com certificado de CA confiavel, deixe `false`.
#  - PORTA FIXA, nao nome de instancia. O conector do Prisma nao resolve
#    `SERVIDOR\SQLEXPRESS`: e preciso habilitar TCP/IP no SQL Server
#    Configuration Manager e fixar a porta (1433), porque Express usa porta
#    dinamica e depende do SQL Browser.
#  - Autenticacao do SQL Server (mixed mode) precisa estar habilitada: o
#    conector nao usa autenticacao integrada do Windows.
#  - O database precisa ser criado com collation CI. Ver deploy/criar-banco.sql.
DATABASE_URL=""

# Banco LOCAL de desenvolvimento, em arquivo, sem servidor nenhum.
# Usado pelo schema gerado prisma/schema.sqlite.prisma (pnpm db:local).
#
# Existe em paralelo a DATABASE_URL de proposito: as duas conexoes convivem no
# arquivo, e quem decide qual vale e o schema com que o client foi gerado
# (`pnpm db:local` para SQLite, `pnpm db:sqlserver` para voltar).
DATABASE_URL_SQLITE="file:./dev.db"

# Segredo do JWT. Gere um novo por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor"
JWT_EXPIRES_IN="8h"

# Origens liberadas para CORS (separadas por virgula)
CORS_ORIGINS="http://localhost:3000"

# Administrador inicial criado pelo seed.
#
# A senha e PROVISORIA: o portal exige a troca no primeiro acesso. Ainda assim,
# nao deixe um valor real aqui — este arquivo e versionado, e senha de exemplo
# tem o habito de virar senha de producao.
SEED_ADMIN_EMAIL="admin@grupotrigo.com.br"
SEED_ADMIN_PASSWORD="troque-este-valor"

# Chave que cifra os parametros do tipo SECRET no banco (AES-256-GCM).
# 32 bytes em hexadecimal. Gere uma por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENCAO: perder esta chave torna os valores SECRET irrecuperaveis.
PARAMETER_ENCRYPTION_KEY=""

# --- Protheus ---
# URL, empresa, filial, usuario e senha sao configurados em
# Configurador > Parametros. As variaveis abaixo servem apenas de fallback,
# util para ambiente automatizado que sobe sem banco populado.
# PROTHEUS_REST_URL="http://servidor-protheus:8080/rest"
# PROTHEUS_USUARIO=""
# PROTHEUS_SENHA=""
