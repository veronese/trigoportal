// ============================================================================
// ARQUIVO GERADO — nao edite a mao.
//
// Origem: prisma/schema.prisma (SQL Server, que e a producao e a fonte de
// verdade). Regere com:
//
//   pnpm --filter @trigo/bff db:sqlite:gerar
//
// Serve apenas para desenvolvimento local em arquivo, sem servidor de banco.
// Diferencas em relacao ao original, todas mecanicas: provider sqlite, sem
// tipos nativos @db.* e sem nome de constraint (map:). Modelos, campos e nomes
// de tabela/coluna sao identicos.
//
// LIMITE CONHECIDO: o SQLite compara texto com case SENSITIVE por padrao. A
// busca por nome/e-mail e por descricao de produto, que em SQL Server ignora
// caixa por causa da collation CI, aqui diferencia. E uma diferenca de
// comportamento entre dev e producao — nao um defeito do portal.
// ============================================================================

// Azure SQL Database (SQL Server).
//
// ============================================================================
// CONVENCAO DE NOMES NO BANCO  (ver README > Convencao de nomes)
// ============================================================================
//   Tabela .......... tp_<plural_em_snake_case>      tp_users, tp_parameters
//   Coluna .......... snake_case                     password_hash, is_active
//   Booleano ........ is_ / has_ / must_             is_active, must_change_password
//   Data/hora ....... sufixo _at ou _until           created_at, locked_until
//   PK .............. tp_<tabela>_pk
//   Unico ........... tp_<tabela>_<colunas>_uq
//   Indice .......... tp_<tabela>_<colunas>_idx
//
// O modelo Prisma segue PascalCase em ingles, com @@map/@map traduzindo para o
// banco. Assim `prisma.user.findMany()` nao muda no codigo, e o SQL fica no
// padrao de SQL. Nomes de constraint sao fixados com `map:` de proposito: sem
// isso o Prisma inventa o nome e a convencao se perde.
//
// PALAVRAS RESERVADAS evitadas: `User` (erro 156 sem colchetes), `group`
// (de GROUP BY) e `value`. Prefixo tp_ e sufixo descritivo resolvem de vez.
//
// ============================================================================
// TRES CUIDADOS especificos do SQL Server, aprendidos na migracao do SQLite e
// que nao aparecem em teste com pouco dado:
// ============================================================================
// 1. TAMANHO EM COLUNA INDEXADA. Sem `` o Prisma mapeia String
//    para NVARCHAR(1000) = 2000 bytes. O limite de chave de indice do SQL Server
//    e 900 bytes (clustered) e 1700 (nonclustered), entao a PK e o unico de
//    e-mail nem seriam criados. Toda coluna indexada tem tamanho explicito.
//
// 2. NULL EM CONSTRAINT UNICA. SQL Server trata NULLs como IGUAIS; SQLite e
//    PostgreSQL tratam como distintos. Um @@unique([provider, externalId])
//    comum rejeitaria o segundo usuario local (todos tem external_id NULL).
//    A unicidade real vive no indice filtrado de prisma/sql/.
//
// 3. TEXTO LONGO. current_value guarda credencial cifrada: com senha no limite
//    do schema o ciphertext passa de 1000 caracteres. Usa NVarChar(Max).
//
// A collation padrao do Azure SQL e case-insensitive (CI_AS): a busca por
// nome/e-mail em Cadastros > Usuarios ignora maiusculas, o que no SQLite nao
// acontecia.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL_SQLITE")
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String? @map("password_hash")
  role         String  @default("USER")
  isActive     Boolean @default(true) @map("is_active")

  // Origem da identidade: "local" agora; "protheus" / "entra" na fase 2.
  provider   String  @default("local")
  externalId String? @map("external_id")

  // Incrementar invalida todos os JWT emitidos para o usuario (revogacao de sessao).
  tokenVersion Int @default(0) @map("token_version")

  // Trava a sessao na tela de troca de senha. Marcado quando um admin cria o
  // usuario (se SENHA_EXIGE_TROCA_PRIMEIRO_ACESSO estiver ativo) e sempre que
  // um admin redefine a senha de alguem.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")

  // Quando a senha provisoria atual foi emitida. Serve para o prazo de
  // validade (SENHA_PROVISORIA_VALIDADE_HORAS).
  provisionalPasswordAt DateTime? @map("provisional_password_at")

  // Bloqueio por tentativas. Zerado a cada login bem-sucedido.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([provider, externalId])
  @@map("tp_users")
}

/// Modulo Configurador: parametrizacao sistemica.
/// Uma linha por parametro, no espirito da SX6 do Protheus.
///
/// EXCECAO CONSCIENTE a regra "PK sempre id": `key` E a identidade do parametro
/// — o catalogo, a API e o cache todos o enderecam por ela. Um id surrogate
/// aqui seria coluna que ninguem usa.
model Parameter {
  key         String  @id
  label       String
  description String?

  /// `group` e palavra reservada (GROUP BY): mapeada para group_name.
  group String @map("group_name")

  /// Tipo do valor: STRING | NUMBER | BOOLEAN | SECRET | CREDENTIAL.
  type String @default("STRING") @map("value_type")

  /// Sempre string. A coercao acontece na leitura, conforme `type`.
  /// NVarChar(Max): credencial cifrada passa de 1000 caracteres.
  /// `value` tambem e ambiguo em SQL: mapeado para current_value.
  value        String? @map("current_value")
  defaultValue String? @map("default_value")

  /// SECRET e CREDENTIAL nunca saem do servidor: a API devolve apenas hasValue.
  isSecret Boolean @default(false) @map("is_secret")

  /// e-mail de quem alterou por ultimo — rastreabilidade sem tabela de auditoria.
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([group])
  @@map("tp_parameters")
}

// ============================================================================
// Espelho de cadastros do Protheus
// ============================================================================
// Copia local dos cadastros do ERP, para o portal consultar sem bater no
// appserver a cada tela. O Protheus segue sendo a fonte de verdade: aqui nada
// e editado pelo portal, so sincronizado.
//
// `syncedAt` em toda tabela: sem ele nao se distingue "registro nao existe no
// Protheus" de "sincronizacao nunca rodou".

/// Empresas e filiais, espelhadas de SYS_COMPANY.
model Company {
  id String @id @default(uuid())

  /// M0_CODIGO — grupo de empresa.
  code   String
  /// M0_CODFIL — filial.
  branch String

  /// M0_NOME — razao social do grupo.
  corporateName String  @map("corporate_name")
  /// M0_FILIAL — nome da filial.
  branchName    String? @map("branch_name")
  /// M0_CGC
  taxId         String? @map("tax_id")
  /// M0_ESTCOB / M0_CIDCOB
  state         String?
  city          String?

  isActive Boolean  @default(true) @map("is_active")
  syncedAt DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, branch])
  @@map("tp_companies")
}

/// Produtos unificados de SB1020 e SB1090 num cadastro so.
model Product {
  id String @id @default(uuid())

  /// EMPORI — coluna do PORTAL, nao do Protheus: identifica a empresa de ORIGEM
  /// do registro no cadastro unificado. Recebe sempre o codigo da empresa de
  /// onde a linha veio, sem excecao:
  ///   SB1020 -> '02'
  ///   SB1090 -> '09'
  ///
  /// NOT NULL de proposito: o SQL Server trata NULL como valor IGUAL em indice
  /// unico, entao (NULL, codigo) quebraria a unicidade do cadastro.
  empori String @default("")

  /// Tabela fisica de origem, para rastreabilidade. EMPORI e a regra de
  /// negocio; isto e o fato bruto de onde a linha veio.
  sourceTable String @map("source_table")

  /// B1_COD
  code             String
  /// B1_DESC
  description      String
  /// B1_TIPO
  type             String?
  /// B1_UM
  unit             String?
  /// B1_GRUPO
  group            String? @map("group_code")
  /// B1_LOCPAD — armazem padrao.
  defaultWarehouse String? @map("default_warehouse")
  /// B1_POSIPI — classificacao fiscal (NCM).
  ncm              String?
  /// B1_MODELO — modelo fiscal do documento.
  fiscalModel      String? @map("fiscal_model")

  /// B1_MSBLQL == '1'. No Protheus '2' e vazio significam liberado.
  isBlocked Boolean @default(false) @map("is_blocked")
  /// B1_ATIVO. Dominio S/N; vazio conta como ativo, que e o padrao do ERP.
  isActive  Boolean @default(true) @map("is_active")

  // Contas contabeis. As tres com prefixo X sao campos customizados do Trigo,
  // por isso nao aparecem em SB1 de instalacao padrao.
  /// B1_XCTACUS — centro de custo.
  costCenter     String? @map("cost_center")
  /// B1_XCTADES — conta de despesa.
  expenseAccount String? @map("expense_account")
  /// B1_XCONTA — conta do ativo.
  assetAccount   String? @map("asset_account")
  /// B1_CONTA — conta de receita.
  revenueAccount String? @map("revenue_account")

  /// NAO vem do zWsProdutos: o endpoint nao devolve B1_PRV1. Fica reservado
  /// para quando houver fonte de preco, e por isso sempre NULL hoje.
  salePrice Decimal? @map("sale_price")

  syncedAt DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([empori, code])
  @@index([description])
  @@index([group])
  @@map("tp_products")
}

/// Clientes de SA1090. Tabela unica, compartilhada entre as empresas — por
/// isso NAO tem empori: nao ha origem a distinguir.
model Customer {
  id String @id @default(uuid())

  /// A1_COD / A1_LOJA
  code  String
  store String

  /// A1_NOME / A1_NREDUZ
  name      String
  shortName String? @map("short_name")
  /// A1_CGC
  taxId     String? @map("tax_id")
  /// A1_EST / A1_MUN
  state     String?
  city      String?
  /// A1_TEL / A1_EMAIL
  phone     String?
  email     String?
  /// A1_MSBLQL = '1'
  isBlocked Boolean @default(false) @map("is_blocked")

  syncedAt DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, store])
  @@index([name])
  @@index([taxId])
  @@map("tp_customers")
}

/// Fornecedores de SA2090. Mesma logica do Customer: tabela unica compartilhada.
model Supplier {
  id String @id @default(uuid())

  /// A2_COD / A2_LOJA
  code  String
  store String

  /// A2_NOME / A2_NREDUZ
  name      String
  shortName String? @map("short_name")
  /// A2_CGC
  taxId     String? @map("tax_id")
  /// A2_EST / A2_MUN
  state     String?
  city      String?
  /// A2_TEL / A2_EMAIL
  phone     String?
  email     String?
  /// A2_MSBLQL = '1'
  isBlocked Boolean @default(false) @map("is_blocked")

  syncedAt DateTime @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, store])
  @@index([name])
  @@index([taxId])
  @@map("tp_suppliers")
}

// ============================================================================
// FICHAS TECNICAS DE P&D
// ============================================================================
//
// HIERARQUIA:  Ficha -> Fase -> Versao -> Etapa -> Item
//
// FASE E ENTIDADE PROPRIA, e nao atributo da versao. O motivo e o vinculo de
// origem: a promocao NAO transforma nem apaga a fase anterior, ela cria uma
// fase nova apontando para a versao que a originou. Com fase como coluna, esse
// vinculo nao teria onde morar, e a pergunta "qual Batida Teste originou esta
// FT Producao?" ficaria sem resposta.
//
// CUSTO E PROCESSO SAO FACES DA MESMA VERSAO, e nao versoes irmas. No
// prototipo o usuario alterna entre as duas com um botao dentro do mesmo
// produto — sao dois documentos sobre a MESMA formulacao daquele momento.
// Por isso FichaProcesso e 1-para-1 com FichaVersao.
//
// VERSAO E COPIA, NAO REFERENCIA. O escopo exige que versao salva nunca mude
// quando o custo de um insumo for atualizado. Por isso o preco vive no item da
// etapa, com a data em que foi lido. Gerar versao COPIA as linhas.
//
// Normalizado em vez de JSON congelado porque o escopo pede busca de ficha por
// INSUMO, e insumo dentro de JSON exigiria OPENJSON no SQL Server — consulta
// que nao aproveita indice.

/// Marca ou loja. Primeiro nivel das pastas.
model FichaRestaurante {
  id   String @id @default(uuid())
  nome String

  /// Cor do cabecalho do PDF, para identificar a marca no documento.
  cor String @default("#2f3237")

  ativo  Boolean @default(true)
  fichas Ficha[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nome])
  @@map("tp_ficha_restaurantes")
}

/// Linha de produto (Molhos, Massas). Segundo nivel das pastas.
model FichaLinha {
  id   String @id @default(uuid())
  nome String

  ativo  Boolean @default(true)
  fichas Ficha[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nome])
  @@map("tp_ficha_linhas")
}

/// Linha industrial e sua capacidade por batida.
model LinhaProducao {
  id           String  @id @default(uuid())
  nome         String
  /// Sugerida como quantidade final ao promover para FT Producao.
  capacidadeKg Decimal @map("capacidade_kg")
  ativa        Boolean @default(true)

  fases FichaFase[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nome])
  @@map("tp_linhas_producao")
}

/// Insumo de ficha: materia-prima ou embalagem.
model FichaInsumo {
  id        String @id @default(uuid())
  codigo    String
  descricao String

  /// Insumo de receita e sempre KG. Embalagem tem unidade livre.
  unidade String @default("KG")

  /// materia | embalagem
  categoria String @default("materia")

  /// Custo unitario ATUAL. O item da etapa guarda a copia da epoca.
  custoReferencia Decimal?  @map("custo_referencia")
  custoData       DateTime? @map("custo_data")

  /// Codigo no Protheus. Nulo enquanto provisorio.
  codigoProtheus String? @map("codigo_protheus")

  /// oficial | provisorio
  statusIntegracao String @default("provisorio") @map("status_integracao")

  // Um provisorio, ao ser vinculado, guarda quem e quando. Snapshots antigos
  // NAO sao alterados: eles ja copiaram codigo e descricao.
  vinculadoPor String?   @map("vinculado_por")
  vinculadoEm  DateTime? @map("vinculado_em")

  // Campos so do provisorio, para o P&D nao travar esperando cadastro no ERP.
  fornecedor String?
  marca      String?
  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([codigo])
  @@index([descricao])
  @@index([statusIntegracao])
  @@map("tp_ficha_insumos")
}

/// O produto em desenvolvimento. As pastas saem de restaurante + linha.
model Ficha {
  id     String @id @default(uuid())
  codigo String
  nome   String

  restauranteId String           @map("restaurante_id")
  restaurante   FichaRestaurante @relation(fields: [restauranteId], references: [id])
  linhaId       String           @map("linha_id")
  linha         FichaLinha       @relation(fields: [linhaId], references: [id])

  categoria String?

  fases     FichaFase[]
  auditoria FichaAuditoria[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([codigo])
  @@index([nome])
  @@index([restauranteId, linhaId])
  @@map("tp_fichas")
}

/// Uma das tres fases do desenvolvimento, com vinculo para a que a originou.
model FichaFase {
  id      String @id @default(uuid())
  fichaId String @map("ficha_id")
  ficha   Ficha  @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  /// bancada | batida_teste | ft_producao
  fase String

  /// A VERSAO que originou esta fase. Nula so na bancada, que e o inicio.
  /// Responde "qual Batida Teste originou esta FT Producao?".
  origemVersaoId String?      @map("origem_versao_id")
  origemVersao   FichaVersao? @relation("PromocaoDeFase", fields: [origemVersaoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Escala desta fase, em kg. Bancada 5, batida teste 80, producao 590.
  quantidadeAlvoKg Decimal? @map("quantidade_alvo_kg")

  /// Linha usada, quando a fase e industrial. Registrada no snapshot.
  linhaProducaoId String?        @map("linha_producao_id")
  linhaProducao   LinhaProducao? @relation(fields: [linhaProducaoId], references: [id])

  versoes FichaVersao[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fichaId, fase])
  @@index([origemVersaoId])
  @@map("tp_ficha_fases")
}

/// Snapshot completo e imutavel depois de sair de rascunho.
model FichaVersao {
  id     String    @id @default(uuid())
  faseId String    @map("fase_id")
  fase   FichaFase @relation(fields: [faseId], references: [id], onDelete: Cascade)

  // AS TRES NUMERACOES, que nunca se equivalem automaticamente. Provado pela
  // ficha de referencia: custo FTC-P&D-088 rev 000, processo FTP-PRD-245 rev 3.
  /// Contador interno do P&D, incrementado a cada GERAR VERSAO.
  versaoFormula     Int     @map("versao_formula")
  /// Numeracao do documento, no formato da area.
  revisaoDocumental String? @map("revisao_documental")
  /// O que o Protheus devolveu. Nunca inventado.
  revisaoProtheus   String? @map("revisao_protheus")

  /// Nome livre dado pelo usuario ("Mix Fornecedor A/B").
  nome   String?
  motivo String?

  /// rascunho | em_aprovacao | vigente | obsoleta
  status String @default("rascunho")

  /// Quantidade final desta versao e o fator aplicado a partir da origem.
  quantidadeFinalKg Decimal? @map("quantidade_final_kg")
  fatorEscala       Decimal? @map("fator_escala")

  pesoUnitario Decimal? @map("peso_unitario")
  precoVenda   Decimal? @map("preco_venda")

  // KPIs CONGELADOS ao sair de rascunho. Guardados e nao recalculados: o custo
  // de um insumo muda depois, e a versao antiga tem que responder o mesmo
  // numero. Em rascunho ficam nulos, porque ali recalcula a cada leitura.
  custoBatida  Decimal? @map("custo_batida")
  rendimentoKg Decimal? @map("rendimento_kg")
  custoKg      Decimal? @map("custo_kg")
  custoUnidade Decimal? @map("custo_unidade")

  criadoPor   String    @map("criado_por")
  congeladoEm DateTime? @map("congelado_em")

  // Dados industriais do cabecalho, congelados junto.
  codigoDocumento    String?   @map("codigo_documento")
  area               String?
  descricaoComercial String?   @map("descricao_comercial")
  descricaoTecnica   String?   @map("descricao_tecnica")
  armazenamento      String?
  shelfLifeDias      Int?      @map("shelf_life_dias")
  bagsPorCaixa       Int?      @map("bags_por_caixa")
  caixasPorPallet    Int?      @map("caixas_por_pallet")
  numeroCaldeiras    Int?      @map("numero_caldeiras")
  dataElaboracao     DateTime? @map("data_elaboracao")
  dataRevisao        DateTime? @map("data_revisao")

  etapas      FichaEtapa[]
  aprovacoes  FichaAprovacao[]
  auditoria   FichaAuditoria[]
  integracoes FichaIntegracao[]
  alteracoes  FichaAlteracaoDocumental[]
  processo    FichaProcesso?
  /// Fases originadas por esta versao.
  promoveu    FichaFase[]                @relation("PromocaoDeFase")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([faseId, versaoFormula])
  @@index([status])
  @@map("tp_ficha_versoes")
}

/// Etapa da composicao.
model FichaEtapa {
  id       String      @id @default(uuid())
  versaoId String      @map("versao_id")
  versao   FichaVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  nome  String
  /// receita | subreceita | pre_mistura | kit | processo | montagem | embalagem
  tipo  String
  ordem Int

  usaPercentual Boolean @default(true) @map("usa_percentual")

  /// Divisor das perdas rateadas.
  mediaBatidas Int @default(1) @map("media_batidas")

  /// fator | perdas — os dois caminhos NAO dao o mesmo numero.
  rendimentoModo  String   @default("perdas") @map("rendimento_modo")
  rendimentoFator Decimal? @map("rendimento_fator")

  itens  FichaItem[]
  perdas FichaPerda[]

  @@unique([versaoId, ordem])
  @@map("tp_ficha_etapas")
}

/// Item de uma etapa.
model FichaItem {
  id      String     @id @default(uuid())
  etapaId String     @map("etapa_id")
  etapa   FichaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  ordem Int

  // COPIADOS, nao referenciados: a versao historica tem que continuar legivel
  // mesmo que o insumo seja renomeado ou saia do cadastro.
  codigo    String
  descricao String
  unidade   String

  /// fixa | proporcional | multiplo_lote | saida_etapa | coef_rend | coef_linha
  modo String @default("fixa")

  qtd Decimal?

  /// Custo unitario DA EPOCA, com a data em que foi lido. O escopo exige as duas.
  preco     Decimal   @default(0)
  precoData DateTime? @map("preco_data")

  base Decimal?
  coef Decimal?
  lote Int?

  /// saida_etapa: id da etapa. coef_linha: id do item de referencia.
  ref String?

  /// Ligacao com o cadastro, para busca por insumo.
  insumoId   String? @map("insumo_id")
  /// Era provisorio quando esta versao foi congelada.
  provisorio Boolean @default(false)

  @@index([etapaId, ordem])
  @@index([insumoId])
  @@index([codigo])
  @@map("tp_ficha_itens")
}

/// Perda declarada na etapa.
model FichaPerda {
  id      String     @id @default(uuid())
  etapaId String     @map("etapa_id")
  etapa   FichaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  nome    String
  valorKg Decimal @map("valor_kg")
  unidade String  @default("KG")

  /// Alternativa ao valor absoluto. Fracao: 0,05 e 5%.
  percentual Decimal?

  /// sobre_entrada | sobre_saida — muda a conta de recomposicao do rendimento.
  tipo String @default("sobre_entrada")

  /// Perda por producao, diluida na media de batidas.
  rateada    Boolean @default(false)
  observacao String?

  ordem Int @default(0)

  @@index([etapaId])
  @@map("tp_ficha_perdas")
}

/// Ficha de Processo: a MESMA versao, outra face. Por isso 1-para-1.
model FichaProcesso {
  id       String      @id @default(uuid())
  versaoId String      @unique @map("versao_id")
  versao   FichaVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  /// Documento proprio, com numeracao propria: FTP-PRD-245 rev 3.
  codigoDocumento String? @map("codigo_documento")
  revisao         String?

  conservacao          String?
  rendimentoIndustrial String? @map("rendimento_industrial")

  // Padroes sensoriais. Inline por serem cinco campos de texto de uma ficha so.
  sensorialCor     String? @map("sensorial_cor")
  sensorialSabor   String? @map("sensorial_sabor")
  sensorialAroma   String? @map("sensorial_aroma")
  sensorialTextura String? @map("sensorial_textura")
  sensorialAspecto String? @map("sensorial_aspecto")

  /// Imagem do padrao sensorial, que sai no PDF.
  imagemUrl String? @map("imagem_url")

  passos       FichaProcessoPasso[]
  ingredientes FichaIngredienteOperacional[]

  @@map("tp_ficha_processos")
}

/// Um passo do modo de preparo, com os parametros que hoje vivem em prosa.
model FichaProcessoPasso {
  id         String        @id @default(uuid())
  processoId String        @map("processo_id")
  processo   FichaProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)

  ordem     Int
  descricao String

  // Extraidos do texto: "velocidade 2, por 5 minutos", "consistencia a quente
  // (170 a 180)". Opcionais porque nem todo passo tem todos.
  equipamento   String?
  velocidade    String?
  tempoMinutos  Decimal? @map("tempo_minutos")
  temperatura   String?
  pontoControle String?  @map("ponto_controle")
  observacao    String?

  @@unique([processoId, ordem])
  @@map("tp_ficha_processo_passos")
}

/// Ingrediente como a fabrica o enxerga. NAO substitui a quantidade da BOM.
model FichaIngredienteOperacional {
  id         String        @id @default(uuid())
  processoId String        @map("processo_id")
  processo   FichaProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)

  ordem Int
  nome  String

  /// Pode ser NULA: na ficha de referencia o creme de leite varia por
  /// fornecedor e so a orientacao operacional existe.
  quantidadeKg Decimal? @map("quantidade_kg")

  /// "4 pacotes", "1 saco", "Terra Viva 7,200 / Quata 5,200 — 1 balde".
  orientacao String

  @@unique([processoId, ordem])
  @@map("tp_ficha_ingredientes_operacionais")
}

/// Assinatura de uma area sobre uma versao.
model FichaAprovacao {
  id       String      @id @default(uuid())
  versaoId String      @map("versao_id")
  versao   FichaVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  /// pd | qualidade | fabrica | producao — AREA, nao pessoa.
  area  String
  ordem Int

  /// pendente | aprovado | reprovado
  status String @default("pendente")

  decididoPor String?   @map("decidido_por")
  decididoEm  DateTime? @map("decidido_em")
  /// Obrigatorio quando reprovado.
  comentario  String?

  /// Identificador da aprovacao: a evidencia, nao a imagem da assinatura.
  identificador String?

  @@unique([versaoId, area])
  @@index([status])
  @@map("tp_ficha_aprovacoes")
}

/// Historico documental, que sai impresso na Ficha de Processo.
model FichaAlteracaoDocumental {
  id       String      @id @default(uuid())
  versaoId String      @map("versao_id")
  versao   FichaVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  revisao     String
  data        DateTime
  alteracao   String
  responsavel String

  @@index([versaoId])
  @@map("tp_ficha_alteracoes_documentais")
}

/// Auditoria tecnica automatica, separada do historico documental.
model FichaAuditoria {
  id      String @id @default(uuid())
  fichaId String @map("ficha_id")
  ficha   Ficha  @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  /// SEM CASCATA: a auditoria alcanca Ficha por dois caminhos e o SQL Server
  /// recusa. Excluir a ficha ja limpa pelo fichaId.
  versaoId String?      @map("versao_id")
  versao   FichaVersao? @relation(fields: [versaoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// criou | editou | gerou_versao | promoveu | aprovou | reprovou | integrou |
  /// erro_protheus | vinculou_produto | cancelou | publicou
  evento String

  /// O que mudou, quando aplicavel.
  campo         String?
  valorAnterior String? @map("valor_anterior")
  valorNovo     String? @map("valor_novo")

  autor  String
  motivo String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fichaId, createdAt])
  @@index([evento])
  @@map("tp_ficha_auditoria")
}

/// Tentativa de integracao com o Protheus. Falha NAO gera versao nova.
model FichaIntegracao {
  id       String      @id @default(uuid())
  versaoId String      @map("versao_id")
  versao   FichaVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  /// nao_integrado | pendente | integrando | integrado | erro
  status String @default("pendente")

  codigoProduto   String? @map("codigo_produto")
  /// Revisao devolvida pelo ERP. Nunca inventada pelo portal.
  revisaoProtheus String? @map("revisao_protheus")

  mensagem  String?
  tentativa Int     @default(1)

  autor     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([versaoId, createdAt])
  @@index([status])
  @@map("tp_ficha_integracoes")
}
