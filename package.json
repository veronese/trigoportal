{
  "name": "trigo-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm build:packages",
    "build:packages": "pnpm --filter @trigo/core build && pnpm --filter @trigo/api-client build",
    "dev": "pnpm -r --parallel --filter=!@trigo/bff dev",
    "dev:api": "pnpm --filter @trigo/api dev",
    "dev:legado": "pnpm --filter @trigo/bff dev",
    "build": "pnpm build:packages && pnpm --filter @trigo/web build",
    "typecheck": "pnpm -r typecheck",
    "parametros": "pnpm --filter @trigo/api parametros",
    "db:studio:legado": "pnpm --filter @trigo/bff db:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
