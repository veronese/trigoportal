  "components": {
    "schemas": {
      "AtualizarCredencialInput": {
        "properties": {
          "usuario": {
            "type": "string",
            "maxLength": 320,
            "minLength": 1,
            "title": "Usuario"
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "usuario",
          "senha"
        ],
        "title": "AtualizarCredencialInput"
      },
      "AtualizarParametroInput": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "AtualizarParametroInput"
      },
      "ColunaBanco": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "tamanho": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tamanho"
          },
          "aceitaNulo": {
            "type": "boolean",
            "title": "Aceitanulo"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "tamanho",
          "aceitaNulo"
        ],
        "title": "ColunaBanco",
        "description": "Uma coluna, como o dicionário físico a descreve."
      },
      "ConsultaSqlInput": {
        "properties": {
          "sql": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Sql"
          },
          "limite": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Limite",
            "default": 500
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "ConsultaSqlInput"
      },
      "ConsultaSqlResult": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "colunas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Colunas"
          },
          "linhas": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Linhas"
          },
          "totalLinhas": {
            "type": "integer",
            "title": "Totallinhas"
          },
          "truncado": {
            "type": "boolean",
            "title": "Truncado"
          },
          "duracaoMs": {
            "type": "integer",
            "title": "Duracaoms"
          },
          "erro": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Erro"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "colunas",
          "linhas",
          "totalLinhas",
          "truncado",
          "duracaoMs",
          "erro"
        ],
        "title": "ConsultaSqlResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 1,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password",
            "description": "Senha em texto, sobre TLS"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginInput",
        "description": "Credenciais do login.\n\nO e-mail NÃO passa por validação de formato aqui, e isso é deliberado. No\nlogin ele é apenas a chave de busca: recusar antes de consultar não protege\nnada — a senha ainda precisaria conferir — e o validador do Pydantic é mais\nrígido que o do backend anterior. Ele recusa domínio de uso interno\n(``.local``, por exemplo), que o ``zod.email()`` aceitava. Manter o rigor\naqui trancaria para fora qualquer conta em domínio interno já cadastrada.\n\nFormato de e-mail se valida no CADASTRO do usuário, onde recusar é barato e\na pessoa pode corrigir. Ver ``CriarUsuarioInput``."
      },
      "ParametroPublico": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "group": {
            "type": "string",
            "title": "Group"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "defaultValue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Defaultvalue"
          },
          "isSecret": {
            "type": "boolean",
            "title": "Issecret"
          },
          "temValor": {
            "type": "boolean",
            "title": "Temvalor"
          },
          "usuario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usuario"
          },
          "updatedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedby"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "description",
          "group",
          "type",
          "value",
          "defaultValue",
          "isSecret",
          "temValor",
          "updatedBy",
          "updatedAt"
        ],
        "title": "ParametroPublico",
        "description": "Um parâmetro como a tela o vê.\n\nNÃO TEM O VALOR DO SEGREDO. Para tipo SECRET e CREDENTIAL, ``value`` volta\nnulo e ``temValor`` diz se algo está guardado. Mascarar seria pior que\nomitir: sugere que existe um jeito de ler pela API."
      },
      "ProtheusDbConfig": {
        "properties": {
          "host": {
            "type": "string",
            "title": "Host"
          },
          "porta": {
            "type": "integer",
            "title": "Porta"
