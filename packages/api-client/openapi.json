    "/api/protheus-db/consultar": {
      "post": {
        "tags": [
          "protheus-db"
        ],
        "summary": "Consultar",
        "description": "Executa a consulta escrita no console.\n\nPOST e não GET, apesar de ser leitura: o SQL vai no corpo. Em query string\nele apareceria no log do servidor e no histórico do navegador, e consulta\nao ERP pode conter código de cliente, valor e nome.",
        "operationId": "consultar_api_protheus_db_consultar_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
